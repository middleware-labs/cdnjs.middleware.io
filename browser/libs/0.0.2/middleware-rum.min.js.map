  "description": "",
  "main": "index.js",
  "scripts": {
    "bundle": "./node_modules/.bin/esbuild index.js --bundle --platform=browser --target=es2017 --format=iife --outfile=script/middleware-rum.js",
    "browserify": "npm run bundle",
    "minify": "./node_modules/.bin/esbuild index.js --bundle --platform=browser --target=es2017 --format=iife --minify --sourcemap --outfile=script/middleware-rum.min.js",
    "test": "nyc mocha --exit",
    "smoke": "node test/smoke/init.smoke.js",
    "format": "prettier --write \"packages/**/*.{js,ts,json,css,md}\" \"test/**/*.{js,ts,json,css,md}\""
  },
  "author": "@middleware.io",
